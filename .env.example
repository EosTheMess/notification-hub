# Notification Hub - Environment Configuration
# Copy this file to `.env` and fill in your values. Never commit `.env` to git.

# --- Network / Pairing ---
# Local port the hub listens on for WebSocket + mDNS connections
HUB_PORT=8765
# mDNS service type
MDNS_SERVICE_TYPE=_notification-hub._tcp

# --- Device discovery ---
# Enable / disable automatic mDNS discovery (true/false)
ENABLE_MDNS_DISCOVERY=true

# --- Notification handling ---
# Default deduplication window (none|seconds30|minutes1|minutes5|minutes15|hour1)
DEDUP_WINDOW=minutes5
# Enable / disable deduplication (true/false)
ENABLE_DEDUPLICATION=true
# Minimum notification priority (low|normal|high|critical)
MIN_PRIORITY=low

# --- Logging ---
# Log level: debug|info|warn|error
LOG_LEVEL=debug

# --- iOS / APNs ---
# APNs bundle ID used for remote notifications (replace with your own)
APNS_BUNDLE_ID=com.notificationhub
# APNs key id (for server-side push, optional)
APNS_KEY_ID=
# APNs team id (for server-side push, optional)
APNS_TEAM_ID=

# --- Android ---
# Firebase Cloud Messaging sender id (optional, for push)
FCM_SENDER_ID=

# --- Feature flags ---
# Enable quick replies (true/false)
ENABLE_QUICK_REPLY=false
# Enable media attachments (true/false)
ENABLE_MEDIA_ATTACHMENTS=true
